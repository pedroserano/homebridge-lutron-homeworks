{
  "private": false,
  "displayName": "Lutron Homeworks Ethernet",
  "name": "homebridge-lutron-homeworks-ethernet",
  "version": "0.2.0",
  "description": "Homebridge plugin for the Lutron Homeworks system over RS232 or ethernet (TCP/Telnet)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroserano/homebridge-lutron-homeworks.git"
"bugs": {
    "url": "https://github.com/pedroserano/homebridge-lutron-homeworks/issues"
  },
    "homepage": "https://github.com/pedroserano/homebridge-lutron-homeworks#readme",
  "author": "Pedro Serano",
  "files": ["dist", "config.schema.json", "README.md", "LICENSE"],
  "engines": {
    "node": "^18.20.4 || ^20.15.1 || ^22",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0"
  },
  "keywords": ["homebridge-plugin", "lutron", "homeworks", "lutron-homeworks", "ethernet", "telnet"]
}
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "@serialport/parser-readline": "^10.5.0",
    "serialport": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^14.10.3",
    "@typescript-eslint/eslint-plugin": "^4.1.1",
    "@typescript-eslint/parser": "^4.1.1",
    "eslint": "^7.9.0",
    "homebridge": "^1.2.2",
    "nodemon": "^2.0.4",
    "rimraf": "^3.0.2",
    "ts-node": "^9.0.0",
    "typescript": "^4.0.2"
  }
}
